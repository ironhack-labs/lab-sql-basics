s/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Solved.sql" filename="C:/Users/Ordenador/Desktop/Ironhack bootcamp/Week3/Day1/lab-sql-basics/files_for_lab/Solved.sql">-- Vínculo al archivo &quot;C:/Users/Ordenador/Desktop/Ironhack bootcamp/Week3/Day1/lab-sql-basics/files_for_lab/Solved.sql&quot; (no soportado en esta versión) --</sql><sql name="SQL 2*">SELECT client_id 
from client 
where district_id==72 
order by client_id 
DESC limit 1</sql><sql name="SQL 3*">SELECT amount
from loan
order by amount ASC
limit 3</sql><sql name="Query 4" filename="C:/Users/Ordenador/Desktop/Ironhack bootcamp/Week3/Day1/lab-sql-basics/files_for_lab/Queries.sql">-- Vínculo al archivo &quot;C:/Users/Ordenador/Desktop/Ironhack bootcamp/Week3/Day1/lab-sql-basics/files_for_lab/Queries.sql&quot; (no soportado en esta versión) --</sql><sql name="SQL 5*">SELECT loan_id
FROM loan
WHERE payments = (SELECT MAX(payments) FROM loan);</sql><sql name="SQL 6*">SELECT account_id, amount
FROM loan
ORDER BY account_id ASC
LIMIT 5;</sql><sql name="SQL 7*">select account_id
from loan
where duration=60
order by amount ASC
limit 5</sql><sql name="SQL 8*">select DISTINCT k_symbol
from &quot;order&quot;</sql><sql name="SQL 9*">select order_id
from &quot;order&quot; 
where account_id=34</sql><sql name="SQL 10*">SELECT DISTINCT account_id
FROM &quot;order&quot;
WHERE order_id BETWEEN 29540 AND 29560;</sql><sql name="SQL 11"></sql><current_tab id="0"/></tab_sql></sqlb_project>
