="62"/><column index="6" value="70"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="trans" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="62"/><column index="2" value="69"/><column index="3" value="54"/><column index="4" value="54"/><column index="5" value="117"/><column index="6" value="62"/><column index="7" value="70"/><column index="8" value="62"/><column index="9" value="36"/><column index="10" value="70"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT client_id FROM client WHERE district_id == 1 ORDER BY client_id asc LIMIT 5;
-- Answer: client_id 2, 3, 22, 23, 28
SELECT client_id FROM client WHERE district_id == 72 ORDER BY client_id desc LIMIT 1;
-- Answer_ client_id 13576
SELECT amount FROM loan ORDER BY amount asc LIMIT 3;
-- Answer: amount 4980, 5148, 7656
SELECT status FROM loan GROUP BY status ORDER BY status asc;
-- Answer: status A, B, C, D
SELECT loan_id FROM loan ORDER BY payments desc LIMIT 1;
-- Answer: loan_id 6415
SELECT account_id, amount FROM loan ORDER BY account_id asc LIMIT 5;
-- Answer: account_id: amount | 2: 80952 | 19: 30276 | 25: 30276 | 37: 318480 | 38: 110736
SELECT account_id FROM loan WHERE duration == 60 ORDER BY amount LIMIT 5;
-- Answer: account_id 10954, 938, 10711, 1766, 10799
SELECT DISTINCT k_symbol from 'order';
-- Answer: k_symbol SIPO, UVER,  ,POJISTNE, LEASING
SELECT order_id from 'order' WHERE account_id == 34;
--Answer: order_id 29445, 29446, 29447
SELECT DISTINCT account_id from 'order' WHERE order_id &gt;= 29540 AND order_id &lt;= 29560;
-- Answer: account_id 88, 90, 96, 97
SELECT amount from 'order' WHERE account_to == 30067122;
-- Answer: amount 5123.0
SELECT trans_id, date, type, amount from trans WHERE account_id== 793 ORDER BY date desc LIMIT 10;
-- Answer: table matching &quot;expected results&quot;
SELECT COUNT(client_id) from client WHERE district_id&lt;10 GROUP BY district_id ORDER BY district_id asc;
-- Answer: COUNT(client_id) 663, 46, 63, 50, 71, 53, 45, 69, 60
SELECT type, COUNT (card_id) from card GROUP BY type ORDER BY COUNT (card_id) desc;
-- Answer: type: count | classic: 659 | junior: 145 | gold: 88
SELECT account_id, SUM(amount) from loan GROUP BY account_id ORDER BY SUM (amount) desc LIMIT 10;
-- Answer: matching the expected results
SELECT date, COUNT(loan_id) from loan WHERE date &lt; 930907 GROUP BY date ORDER BY date desc;
-- Answer: date: COUNT | 930906: 1 | 930803: 1 | 930728:1 | 930711:1 | 930705:1
SELECT date, duration, COUNT(loan_id) from loan WHERE date LIKE '9712%' GROUP BY duration, date ORDER BY date, duration; 
--Answer: matching expected results
SELECT account_id, type, SUM(amount) AS 'total sum' from trans WHERE account_id==396 AND (type=='VYDAJ'OR type=='PRIJEM') GROUP BY type ORDER BY type;
--Answer: matching expected results






